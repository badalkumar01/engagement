# --- Copy this file to ".env" and fill in real values. NEVER commit .env. ---
# API keys live ONLY here on the server, never in the extension.

# Which LLM drafts the comments: "gemini" or "claude".
LLM_PROVIDER=gemini

# How long to wait on the LLM before giving up (ms).
LLM_TIMEOUT_MS=30000

# --- Gemini ---
# Get an API key from Google AI Studio (https://aistudio.google.com/apikey).
# Real Gemini API keys start with "AIza".
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=400

# --- Claude ---
# Examples: claude-haiku-4-5-20251001 (fast/cheap), claude-sonnet-5-5 (higher quality).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=400

# Secret used to sign JWTs issued after a successful license check. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued session token stays valid.
JWT_EXPIRES_IN=30d

# Server port.
PORT=8787

# Comma-separated list of allowed CORS origins. The Chrome extension's origin is
# chrome-extension://<EXTENSION_ID>. Add it once you have loaded the unpacked extension.
# During local dev you can leave this as the wildcard, but tighten it for production.
ALLOWED_ORIGINS=*

# SQLite database file path (relative to backend/ or absolute).
DB_PATH=./data/app.db

# --- Daily email report (optional) ---
# Leave SMTP_HOST / MAIL_FROM empty to disable email; the app runs fine without it.
# For Gmail use an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Engagement Assistant <you@example.com>"
# When the daily report is sent (cron, server time). Default 6pm.
REPORT_CRON=0 18 * * *
