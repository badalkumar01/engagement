{
  "manifest_version": 3,
  "name": "Engagement Assistant",
  "version": "1.1.0",
  "description": "Drafts post-specific comments for LinkedIn and Instagram in the comment box for you to review and post yourself.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.instagram.com/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Engagement Assistant"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://www.instagram.com/*"],
      "js": ["src/adapters.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
